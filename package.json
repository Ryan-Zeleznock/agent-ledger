{
  "name": "agent-ledger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:timing",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "check": "npm run typecheck && npm test && npm run build",
    "test:unit": "vitest run --exclude \"test/timing/**\" --reporter=verbose",
    "test:timing": "vitest run test/timing/ --no-file-parallelism --maxWorkers=1 --reporter=verbose"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "pg": "8.23.1",
    "yaml": "2.9.1"
  },
  "bin": {
    "agent-ledger": "dist/cli/main.js"
  }
}
